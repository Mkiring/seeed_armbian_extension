#!/bin/sh
#
# Recovery initramfs init-premount hook: OTA update orchestrator.
#
# Recovery OTA is applied in a single linear transaction. All helpers live in
# the initramfs-specific POSIX sh libraries under /usr/share/armbian-ota/:
# recovery/log.sh, recovery/device.sh, recovery/payload.sh, plus state.sh.
# This script only sources them and drives the ordered steps.

PREREQ=""

prereqs() {
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

. /usr/share/armbian-ota/state.sh
. /usr/share/armbian-ota/find-userdata.sh
. /usr/share/armbian-ota/recovery/log.sh
. /usr/share/armbian-ota/recovery/device.sh
. /usr/share/armbian-ota/recovery/payload.sh

# Enable verbose shell tracing only when explicitly requested.
if [ "${OTA_DEBUG:-no}" = "yes" ]; then
    set -x
fi

# transaction layout
ROOT_MNT="/mnt/root"
BOOT_MNT="/mnt/boot"
USERDATA_MNT="/mnt/userdata"
RECOVERY_TRANSACTION_DIR="${USERDATA_MNT}/ota-recovery"
STATE_DIR=""
STATE_FILE=""
OTA_DIR=""
ROOTFS_TAR=""
BOOT_TAR=""
BOOT_ITB=""

find_userdata_device() {
    local dev

    if [ -b /dev/mapper/armbian-userdata ]; then
        printf '%s\n' /dev/mapper/armbian-userdata
        return 0
    fi

    # Multiple disks can carry identical dd-flashed images, each with a
    # PARTLABEL=userdata partition; blkid | head -n1 below then picks
    # arbitrarily and the prepared state on the boot disk is silently
    # missed. Anchor to the rootfs disk first, same helper as
    # 00-seeed-bind-userdata; keep the label lookups as fallback only.
    if [ -n "${ROOT_DEV}" ]; then
        dev="$(find_user_data__partition_for_root "${ROOT_DEV}" 2>/dev/null || true)"
        if [ -n "${dev}" ] && [ "$(blkid -s TYPE -o value "${dev}" 2>/dev/null || true)" = "ext4" ]; then
            printf '%s\n' "${dev}"
            return 0
        fi
    fi

    dev="$(blkid -t PARTLABEL=userdata -o device 2>/dev/null | head -n1 || true)"
    if [ -n "${dev}" ] && [ "$(blkid -s TYPE -o value "${dev}" 2>/dev/null || true)" = "ext4" ]; then
        printf '%s\n' "${dev}"
        return 0
    fi

    dev="$(blkid -t LABEL=armbi_usrdata -o device 2>/dev/null | head -n1 || true)"
    if [ -n "${dev}" ] && [ "$(blkid -s TYPE -o value "${dev}" 2>/dev/null || true)" = "ext4" ]; then
        printf '%s\n' "${dev}"
    fi
}

mount_recovery_transaction_store() {
    local userdata_dev

    userdata_dev="$(find_userdata_device)"
    [ -n "${userdata_dev}" ] || {
        log "userdata partition is unavailable"
        return 1
    }

    mkdir -p "${USERDATA_MNT}"
    mount -t ext4 -o rw "${userdata_dev}" "${USERDATA_MNT}" || {
        log "failed to mount userdata ${userdata_dev}"
        return 1
    }

    STATE_DIR="${RECOVERY_TRANSACTION_DIR}/state"
    STATE_FILE="${STATE_DIR}/ota-state.env"
    OTA_DIR="${RECOVERY_TRANSACTION_DIR}/ota_work"
    ROOTFS_TAR="$(ota_resolve_payload "${OTA_DIR}" rootfs)"
    BOOT_TAR="$(ota_resolve_payload "${OTA_DIR}" boot)"
    BOOT_ITB="${OTA_DIR}/boot.itb"
}

# Return the payload file actually staged for $2 (rootfs|boot); xz packages
# win over legacy gz. Prints the path, empty when nothing is staged.
ota_resolve_payload() {
    mnt_dir="$1"
    base="$2"

    for suffix in tar.xz tar.gz; do
        if [ -f "${mnt_dir}/${base}.${suffix}" ]; then
            printf '%s\n' "${mnt_dir}/${base}.${suffix}"
            return 0
        fi
    done
    return 0
}

unmount_recovery_transaction_store() {
    if mountpoint -q "${USERDATA_MNT}"; then
        umount "${USERDATA_MNT}" 2>/dev/null || log "WARN: failed to unmount ${USERDATA_MNT}"
    fi
}

mkdir -p "$LOGDIR"
log "init-premount ota hook start"
log "LOGFILE=${LOGFILE}"
touch "${LOGDIR}/ota_ran.init-premount"

# 1) probe devices (sets ROOT_DEV, ROOT_UUID, BOOT_DEV, BOOT_UUID,
#    HAS_BOOT_PART, AUTO_DECRYPT_MODE)
ota_detect_devices

# 2) mount root + validate state
if [ -z "${ROOT_DEV}" ]; then
    log "ROOT_DEV is empty, skip OTA"
    exit 0
fi

if ! mount_recovery_transaction_store; then
    exit 0
fi

mkdir -p "${ROOT_MNT}"
log "mounting ${ROOT_DEV} -> ${ROOT_MNT} ..."
if ! mount -t ext4 -o rw "${ROOT_DEV}" "${ROOT_MNT}"; then
    log "cannot mount ${ROOT_DEV}, skip OTA"
    unmount_recovery_transaction_store
    exit 0
fi

ota_validate_recovery_state || {
    umount "${ROOT_MNT}" 2>/dev/null || true
    unmount_recovery_transaction_store
    exit 0
}

# Raise printk only now that an OTA is confirmed to be pending. On a normal
# boot the early-exit paths above leave console_loglevel untouched so the
# real rootfs stays quiet; the OTA-apply path gets full console visibility
# for the extract/patch work below.
ota_log_init
log "OTA confirmed, applying..."
log "tools: PATH=${PATH} tar=$(command -v tar 2>/dev/null) xz=$(command -v xz 2>/dev/null) tar-flavor=$(/usr/bin/tar --version 2>/dev/null | head -n1)"

# 3) source the staged OTA hook once (definition-only script), then run the
# fixed call points around the built-in apply (docs/10-ota-package-formats.md).
# Mounting, config patching, state commit, unmount and reboot stay here.
DO_BOOT_OTA="${DO_BOOT_OTA:-0}"
if ota_source_staged_hook; then
    OTA_HOOK_MODE="recovery"
    export OTA_HOOK_API OTA_HOOK_MODE OTA_HOOK_PATH
else
    OTA_HOOK_PATH=""
fi

# hook_pre_apply: old rootfs is still readable/writable, nothing rebuilt yet.
if ! ota_call_hook hook_pre_apply; then
    log "ERROR: hook_pre_apply failed, abort OTA"
    umount "${ROOT_MNT}" 2>/dev/null || true
    unmount_recovery_transaction_store
    exit 0
fi

# hook_apply (optional): replaces the built-in payload application entirely.
if [ -n "${OTA_HOOK_PATH}" ] && type hook_apply >/dev/null 2>&1; then
    log "hook_apply takes over payload application"
    ota_capture_pre_ota_env
    start_heartbeat "OTA hook hook_apply running"
    hook_apply
    hook_rc=$?
    stop_heartbeat
    if [ "${hook_rc}" -ne 0 ]; then
        log "ERROR: hook_apply failed rc=${hook_rc}, abort OTA"
        umount "${ROOT_MNT}" 2>/dev/null || true
        unmount_recovery_transaction_store
        exit 0
    fi
    # Expose the boot partition to the config patcher, mirroring the state
    # ota_apply_boot would have left behind. BOOT_MNT is pre-initialized to
    # "/mnt/boot" at the top, so test for an actual mount, not emptiness --
    # otherwise the armbianEnv patch is silently skipped after hook_apply.
    if [ "${HAS_BOOT_PART:-0}" -eq 1 ] && ! mountpoint -q "${BOOT_MNT:-/mnt/boot}"; then
        BOOT_MNT="/mnt/boot"
        mkdir -p "${BOOT_MNT}"
        if mount -t ext4 -o rw "${BOOT_DEV}" "${BOOT_MNT}"; then
            DO_BOOT_OTA=1
        else
            BOOT_MNT=""
            log "WARN: cannot mount ${BOOT_DEV} for config patch after hook"
        fi
    fi
else
    # built-in apply rootfs (mkfs rebuild or rm -rf clean, then extract)
    ota_apply_rootfs || {
        umount "${ROOT_MNT}" 2>/dev/null || true
        unmount_recovery_transaction_store
        exit 0
    }

    # built-in apply boot (mount + extract boot payload, write boot.itb)
    ota_apply_boot || {
        if [ "$DO_BOOT_OTA" -eq 1 ] && [ -n "${BOOT_MNT}" ]; then
            umount "${BOOT_MNT}" 2>/dev/null || true
        fi
        umount "${ROOT_MNT}" 2>/dev/null || true
        unmount_recovery_transaction_store
        exit 0
    }
fi

# 7) fix UUIDs in armbianEnv.txt / fstab / crypttab
ota_patch_config

# 7.5) hook_post_apply: new rootfs is final and still mounted; last chance to
# inject or migrate. Then carry hook_firstboot into the new system.
if ! ota_call_hook hook_post_apply; then
    log "ERROR: hook_post_apply failed, abort OTA"
    ota_unmount_all
    unmount_recovery_transaction_store
    exit 0
fi
if [ -n "${OTA_HOOK_PATH}" ] && type hook_firstboot >/dev/null 2>&1; then
    if mkdir -p "${ROOT_MNT}/usr/share/armbian-ota" && \
       cp "${OTA_HOOK_PATH}" "${ROOT_MNT}/usr/share/armbian-ota/firstboot-hook.sh"; then
        log "staged firstboot hook into new rootfs"
    else
        log "WARN: failed to stage firstboot hook"
    fi
fi

# 8) cleanup payload
log "  delete OTA payload directory ${OTA_DIR} ..."
rm -rf "${OTA_DIR}" || true

# 9) commit success state
ota_commit_success_state

# 10) unmount partitions
ota_unmount_all
unmount_recovery_transaction_store

sync

# 11) reboot
ota_reboot
