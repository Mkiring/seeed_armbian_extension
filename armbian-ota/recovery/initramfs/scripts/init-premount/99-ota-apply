#!/bin/sh
#
# Recovery initramfs init-premount hook: OTA update orchestrator.
#
# Recovery OTA is applied in a single linear transaction. All helpers live in
# the initramfs-specific POSIX sh libraries under /usr/share/armbian-ota/:
# recovery/log.sh, recovery/device.sh, recovery/payload.sh, plus state.sh.
# This script only sources them and drives the ordered steps.

PREREQ=""

prereqs() {
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

OTA_LIB_DIR="${OTA_LIB_DIR:-/usr/share/armbian-ota}"
. "${OTA_LIB_DIR}/state.sh"
. "${OTA_LIB_DIR}/find-userdata.sh"
. "${OTA_LIB_DIR}/recovery/log.sh"
. "${OTA_LIB_DIR}/recovery/device.sh"
. "${OTA_LIB_DIR}/recovery/payload.sh"

# Enable verbose shell tracing only when explicitly requested.
if [ "${OTA_DEBUG:-no}" = "yes" ]; then
    set -x
fi

# transaction layout
ROOT_MNT="/mnt/root"
BOOT_MNT="/mnt/boot"
USERDATA_MNT="/mnt/userdata"
RECOVERY_TRANSACTION_DIR="${USERDATA_MNT}/ota-recovery"
STATE_DIR=""
STATE_FILE=""
OTA_DIR=""
ROOTFS_TAR=""
BOOT_TAR=""
BOOT_ITB=""

find_userdata_device() {
    local dev

    if [ -b /dev/mapper/armbian-userdata ]; then
        printf '%s\n' /dev/mapper/armbian-userdata
        return 0
    fi

    # Multiple disks can carry identical dd-flashed images, each with a
    # PARTLABEL=userdata partition; blkid | head -n1 below then picks
    # arbitrarily and the prepared state on the boot disk is silently
    # missed. Anchor to the rootfs disk first, same helper as
    # 00-seeed-bind-userdata; keep the label lookups as fallback only.
    if [ -n "${ROOT_DEV}" ]; then
        dev="$(find_user_data__partition_for_root "${ROOT_DEV}" 2>/dev/null || true)"
        if [ -n "${dev}" ] && [ "$(blkid -s TYPE -o value "${dev}" 2>/dev/null || true)" = "ext4" ]; then
            printf '%s\n' "${dev}"
            return 0
        fi
    fi

    dev="$(blkid -t PARTLABEL=userdata -o device 2>/dev/null | head -n1 || true)"
    if [ -n "${dev}" ] && [ "$(blkid -s TYPE -o value "${dev}" 2>/dev/null || true)" = "ext4" ]; then
        printf '%s\n' "${dev}"
        return 0
    fi

    dev="$(blkid -t LABEL=armbi_usrdata -o device 2>/dev/null | head -n1 || true)"
    if [ -n "${dev}" ] && [ "$(blkid -s TYPE -o value "${dev}" 2>/dev/null || true)" = "ext4" ]; then
        printf '%s\n' "${dev}"
    fi
}

mount_recovery_transaction_store() {
    local userdata_dev

    userdata_dev="$(find_userdata_device)"
    [ -n "${userdata_dev}" ] || {
        log "userdata partition is unavailable"
        return 1
    }

    mkdir -p "${USERDATA_MNT}"
    mount -t ext4 -o rw "${userdata_dev}" "${USERDATA_MNT}" || {
        log "failed to mount userdata ${userdata_dev}"
        return 1
    }

    STATE_DIR="${RECOVERY_TRANSACTION_DIR}/state"
    STATE_FILE="${STATE_DIR}/ota-state.env"
    OTA_DIR="${RECOVERY_TRANSACTION_DIR}/ota_work"
    ROOTFS_TAR="$(ota_resolve_payload "${OTA_DIR}" rootfs)"
    BOOT_TAR="$(ota_resolve_payload "${OTA_DIR}" boot)"
    BOOT_ITB="${OTA_DIR}/boot.itb"
}

# Return the payload file actually staged for $2 (rootfs|boot); xz packages
# win over legacy gz. Prints the path, empty when nothing is staged.
ota_resolve_payload() {
    mnt_dir="$1"
    base="$2"

    for suffix in tar.xz tar.gz; do
        if [ -f "${mnt_dir}/${base}.${suffix}" ]; then
            printf '%s\n' "${mnt_dir}/${base}.${suffix}"
            return 0
        fi
    done
    return 0
}

unmount_recovery_transaction_store() {
    if mountpoint -q "${USERDATA_MNT}"; then
        umount "${USERDATA_MNT}" 2>/dev/null || log "WARN: failed to unmount ${USERDATA_MNT}"
    fi
}

ota_applier_main() {
    mkdir -p "$LOGDIR"
    log "init-premount ota hook start"
    log "LOGFILE=${LOGFILE}"
    touch "${LOGDIR}/ota_ran.init-premount"

    # 1) probe devices (sets ROOT_DEV, ROOT_UUID, BOOT_DEV, BOOT_UUID,
    #    HAS_BOOT_PART, AUTO_DECRYPT_MODE)
    ota_detect_devices

    if [ -z "${ROOT_DEV}" ]; then
        log "ROOT_DEV is empty, skip OTA"
        exit 0
    fi

    if ! mount_recovery_transaction_store; then
        exit 0
    fi

    BACKUP_DIR="${RECOVERY_TRANSACTION_DIR}/backup"

    # 2) dispatch on the transaction state (design section 5). success /
    # failed / idle / no state exit before the rootfs is ever mounted, so
    # normal boots stay as cheap as they were.
    OTA_STATUS="$(grep -E '^STATUS=' "${STATE_FILE}" 2>/dev/null | tail -n1 | cut -d= -f2- || true)"
    OTA_MODE_VALUE="$(grep -E '^OTA_MODE=' "${STATE_FILE}" 2>/dev/null | tail -n1 | cut -d= -f2- || true)"

    if [ -n "${OTA_STATUS}" ] && [ "${OTA_MODE_VALUE}" != "recovery" ]; then
        log "OTA_MODE=${OTA_MODE_VALUE:-none} is not recovery, skip"
        unmount_recovery_transaction_store
        exit 0
    fi

    case "${OTA_STATUS}" in
        prepared) ota_run_prepared ;;
        applied)  ota_run_rollback ;;
        *)
            log "OTA state=${OTA_STATUS:-none}, nothing to do"
            unmount_recovery_transaction_store
            exit 0
            ;;
    esac
}

# Failed apply of the prepared payload: count it, stop-loss when the budget
# is spent, otherwise leave the state prepared so the next boot retries.
ota_apply_failed() { # $1 = stage description
    log "OTA apply failed: $1"
    ota_unmount_all 2>/dev/null || true
    state_increment_retry "${STATE_FILE}"
    if state_retry_exhausted "${STATE_FILE}"; then
        state_mark_failed "${STATE_FILE}" "apply failed: $1"
        rm -rf "${OTA_DIR}" || true
        log "stop-loss: retry budget exhausted, payload cleared, STATUS=failed"
    else
        log "retry $(state_get_retry_count "${STATE_FILE}")/${OTA_MAX_RETRY} on next boot (STATUS stays prepared)"
    fi
    unmount_recovery_transaction_store
    exit 0
}

# STATUS=applied: the previous apply finished but never reached health
# confirmation (kernel panic, service failure, power cut). Roll back onto
# the retained backup payload through the very same apply machinery.
ota_run_rollback() {
    if [ ! -d "${BACKUP_DIR}" ]; then
        state_mark_failed "${STATE_FILE}" "applied but no backup"
        log "stop-loss: applied without backup, STATUS=failed"
        unmount_recovery_transaction_store
        exit 0
    fi

    state_increment_retry "${STATE_FILE}"
    if state_retry_exhausted "${STATE_FILE}"; then
        state_mark_failed "${STATE_FILE}" "rollback retry exhausted"
        rm -rf "${BACKUP_DIR}" || true
        log "stop-loss: rollback budget exhausted, backup cleared"
        unmount_recovery_transaction_store
        exit 0
    fi

    # The staged payload is convicted: this rollback only runs because it
    # never reached health confirmation. Drop it now -- otherwise the
    # healthy rolled-back system promotes it into backup/ at mark-success
    # and silently replaces the known-good net with the bad one.
    if [ -d "${OTA_DIR}" ]; then
        rm -rf "${OTA_DIR}" || true
        log "convicted payload dropped: ${OTA_DIR}"
    fi

    ota_log_init
    log "last apply was never health-confirmed; rolling back from backup (attempt $(state_get_retry_count "${STATE_FILE}")/${OTA_MAX_RETRY})"

    # Deferral (package.env OTA_BOOT_REFRESH=0) and staged hooks only make
    # sense on the prepared path; the rollback runs the built-in apply and
    # must restore whatever the backup actually carries.
    OTA_HOOK_PATH=""
    DO_BOOT_OTA=0

    BACKUP_PARTIAL_VALUE="$(grep -E '^BACKUP_PARTIAL=' "${STATE_FILE}" 2>/dev/null | tail -n1 | cut -d= -f2- || true)"

    ota_set_payload_dir "${BACKUP_DIR}"
    if [ "${BACKUP_PARTIAL_VALUE}" = "1" ]; then
        if ! ota_validate_payload boot-only; then
            state_mark_failed "${STATE_FILE}" "partial backup payload invalid"
            rm -rf "${BACKUP_DIR}" || true
            log "stop-loss: partial backup failed validation, cleared"
            unmount_recovery_transaction_store
            exit 0
        fi
    else
        if ! ota_validate_payload; then
            state_mark_failed "${STATE_FILE}" "backup payload invalid"
            rm -rf "${BACKUP_DIR}" || true
            log "stop-loss: backup payload failed validation, cleared"
            unmount_recovery_transaction_store
            exit 0
        fi
    fi
    # The deferral gate inside validation sets OTA_BOOT_HOOK_MODE=1 and
    # zeroes HAS_BOOT_TAR when the package asked for a hook-owned boot
    # swap; no hook runs here, so force the gate off and recompute the
    # flags from what the backup really carries. Without this the rollback
    # would restore the rootfs but keep the broken new boot files --
    # exactly the version mismatch design 2.2 warns about.
    OTA_BOOT_HOOK_MODE=0
    HAS_BOOT_TAR=0
    [ -f "${BOOT_TAR}" ] && HAS_BOOT_TAR=1
    HAS_BOOT_ITB=0
    [ -f "${BOOT_ITB}" ] && HAS_BOOT_ITB=1

    mkdir -p "${ROOT_MNT}"
    if ! mount -t ext4 -o rw "${ROOT_DEV}" "${ROOT_MNT}"; then
        log "cannot mount ${ROOT_DEV} for rollback; retry next boot"
        unmount_recovery_transaction_store
        exit 0
    fi

    start_heartbeat "OTA rollback applying backup"
    if [ "${BACKUP_PARTIAL_VALUE}" = "1" ]; then
        log "BACKUP_PARTIAL=1: boot-only rollback, rootfs untouched"
    else
        ota_apply_rootfs || {
            stop_heartbeat
            log "rollback rootfs apply failed; retry next boot"
            ota_unmount_all
            unmount_recovery_transaction_store
            exit 0
        }
        ota_clean_overlay_upper
    fi
    ota_apply_boot || {
        stop_heartbeat
        log "rollback boot apply failed; retry next boot"
        ota_unmount_all
        unmount_recovery_transaction_store
        exit 0
    }
    stop_heartbeat

    ota_patch_config
    ota_commit_applied_state
    ota_unmount_all
    unmount_recovery_transaction_store
    sync
    ota_reboot
}

# STATUS=prepared: the normal apply pipeline, hooks included.
ota_run_prepared() {
    mkdir -p "${ROOT_MNT}"
    log "mounting ${ROOT_DEV} -> ${ROOT_MNT} ..."
    if ! mount -t ext4 -o rw "${ROOT_DEV}" "${ROOT_MNT}"; then
        log "cannot mount ${ROOT_DEV}, skip OTA"
        unmount_recovery_transaction_store
        exit 0
    fi

    # rc 1 = idle (state or payload not applicable): the historical bare
    # skip. rc 2 = payload present but invalid (sha/encryption/FIT): a
    # retry on the same broken payload would never converge, so it burns
    # the budget and stop-losses like any other apply failure.
    ota_validate_recovery_state
    validate_rc=$?
    if [ "${validate_rc}" -eq 1 ]; then
        umount "${ROOT_MNT}" 2>/dev/null || true
        unmount_recovery_transaction_store
        exit 0
    fi
    [ "${validate_rc}" -eq 0 ] || ota_apply_failed "payload validation"

    # Raise printk only now that an OTA is confirmed to be pending. On a
    # normal boot the early-exit paths above leave console_loglevel
    # untouched so the real rootfs stays quiet; the OTA-apply path gets full
    # console visibility for the extract/patch work below.
    ota_log_init
    log "OTA confirmed, applying..."
    log "tools: PATH=${PATH} tar=$(command -v tar 2>/dev/null) xz=$(command -v xz 2>/dev/null) tar-flavor=$(/usr/bin/tar --version 2>/dev/null | head -n1)"

    # 3) source the staged OTA hook once (definition-only script), then run
    # the fixed call points around the built-in apply
    # (docs/10-ota-package-formats.md). Mounting, config patching, state
    # commit, unmount and reboot stay here.
    DO_BOOT_OTA="${DO_BOOT_OTA:-0}"
    if ota_source_staged_hook; then
        OTA_HOOK_MODE="recovery"
        export OTA_HOOK_API OTA_HOOK_MODE OTA_HOOK_PATH
    else
        OTA_HOOK_PATH=""
    fi

    # hook_pre_apply: old rootfs is still readable/writable, nothing rebuilt
    # yet.
    ota_call_hook hook_pre_apply || ota_apply_failed "hook_pre_apply"

    # hook_apply (optional): replaces the built-in payload application
    # entirely.
    if [ -n "${OTA_HOOK_PATH}" ] && type hook_apply >/dev/null 2>&1; then
        log "hook_apply takes over payload application"
        ota_capture_pre_ota_env
        start_heartbeat "OTA hook hook_apply running"
        hook_apply
        hook_rc=$?
        stop_heartbeat
        [ "${hook_rc}" -eq 0 ] || ota_apply_failed "hook_apply rc=${hook_rc}"
        # Expose the boot partition to the config patcher, mirroring the
        # state ota_apply_boot would have left behind. BOOT_MNT is
        # pre-initialized to "/mnt/boot" at the top, so test for an actual
        # mount, not emptiness -- otherwise the armbianEnv patch is
        # silently skipped after hook_apply.
        if [ "${HAS_BOOT_PART:-0}" -eq 1 ] && ! mountpoint -q "${BOOT_MNT:-/mnt/boot}"; then
            BOOT_MNT="/mnt/boot"
            mkdir -p "${BOOT_MNT}"
            if mount -t ext4 -o rw "${BOOT_DEV}" "${BOOT_MNT}"; then
                DO_BOOT_OTA=1
            else
                BOOT_MNT=""
                log "WARN: cannot mount ${BOOT_DEV} for config patch after hook"
            fi
        fi
        ota_clean_overlay_upper
    else
        # built-in apply rootfs (mkfs rebuild or rm -rf clean, then extract)
        ota_apply_rootfs || ota_apply_failed "rootfs apply"

        # Same-release kernel OTA: stale copy-up'd modules in the overlay
        # upper would shadow the fresh lower set with matching vermagic
        # (design section 6.1). Runs after the rootfs rebuild, before boot.
        ota_clean_overlay_upper

        # built-in apply boot (mount + space-check + extract, write boot.itb)
        ota_apply_boot || {
            if [ "$DO_BOOT_OTA" -eq 1 ] && [ -n "${BOOT_MNT}" ]; then
                umount "${BOOT_MNT}" 2>/dev/null || true
            fi
            ota_apply_failed "boot apply"
        }
    fi

    # 7) fix UUIDs in armbianEnv.txt / fstab / crypttab
    ota_patch_config

    # 7.5) hook_post_apply: new rootfs is final and still mounted; last
    # chance to inject or migrate. Then carry hook_firstboot into the new
    # system.
    ota_call_hook hook_post_apply || ota_apply_failed "hook_post_apply"
    if [ -n "${OTA_HOOK_PATH}" ] && type hook_firstboot >/dev/null 2>&1; then
        if mkdir -p "${ROOT_MNT}/usr/share/armbian-ota" && \
           cp "${OTA_HOOK_PATH}" "${ROOT_MNT}/usr/share/armbian-ota/firstboot-hook.sh"; then
            log "staged firstboot hook into new rootfs"
        else
            log "WARN: failed to stage firstboot hook"
        fi
    fi

    # 8) commit STATUS=applied. ota_work/ is deliberately retained: the
    # health service promotes it to backup/ on confirmation (mark-success),
    # or the next boot rolls back onto it if this system never comes up
    # (design section 3.2).
    # Fresh rollback budget first: retries burned while getting this
    # payload applied must not eat the rollback budget. Reset BEFORE the
    # commit so the carried value (and the rootfs mirror) record 0. The
    # rollback path's own commit deliberately keeps the count so a
    # rollback death loop still reaches its stop-loss.
    state_reset_retry "${STATE_FILE}"
    ota_commit_applied_state

    # 9) unmount partitions
    ota_unmount_all
    unmount_recovery_transaction_store

    sync

    # 10) reboot into the freshly applied system for health confirmation
    ota_reboot
}

# Library mode gate: the state-machine harness (tests/ota_fsm) sources this
# file with OTA_APPLIER_AS_LIB=1 to drive ota_applier_main with stubs.
if [ "${OTA_APPLIER_AS_LIB:-0}" != "1" ]; then
    ota_applier_main
fi
