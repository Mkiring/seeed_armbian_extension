#!/bin/sh
#
# initramfs-tools init-bottom hook: mount Recovery OTA persistent overlays.

PREREQ=""

prereqs() {
    echo "${PREREQ}"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

log() {
    echo "[armbian-ota-userdata] $*" > /dev/kmsg 2>/dev/null || true
}

ROOT_MNT=/root
USERDATA_MNT=/run/armbian-ota-userdata
USERDATA_DEV=""

find_userdata_device() {
    local dev

    if [ -b /dev/mapper/armbian-userdata ]; then
        echo /dev/mapper/armbian-userdata
        return 0
    fi

    dev="$(blkid -t PARTLABEL=userdata -o device 2>/dev/null | head -n1 || true)"
    if [ -n "${dev}" ] && [ "$(blkid -s TYPE -o value "${dev}" 2>/dev/null || true)" = "ext4" ]; then
        echo "${dev}"
        return 0
    fi

    dev="$(blkid -t LABEL=armbi_usrdata -o device 2>/dev/null | head -n1 || true)"
    if [ -n "${dev}" ] && [ "$(blkid -s TYPE -o value "${dev}" 2>/dev/null || true)" = "ext4" ]; then
        echo "${dev}"
    fi
}

mount_overlay() {
    local name="$1"
    local lower="${ROOT_MNT}/$2"
    local upper="${USERDATA_MNT}/overlay/${name}/upper"
    local work="${USERDATA_MNT}/overlay/${name}/work"

    [ -d "${lower}" ] || {
        log "WARN: lower directory missing: ${lower}"
        return 0
    }

    mkdir -p "${upper}" "${work}" || {
        log "ERROR: cannot create overlay directories for ${name}"
        return 1
    }
    mount -t overlay overlay -o "lowerdir=${lower},upperdir=${upper},workdir=${work}" "${lower}" || {
        log "ERROR: failed to mount ${name} overlay"
        return 1
    }
    log "mounted persistent overlay for /$2"
}

[ -d "${ROOT_MNT}" ] || exit 0
USERDATA_DEV="$(find_userdata_device)"
[ -n "${USERDATA_DEV}" ] || {
    log "WARN: userdata partition is unavailable; booting without persistent overlays"
    exit 0
}

mkdir -p "${USERDATA_MNT}"
if ! mount -t ext4 -o rw "${USERDATA_DEV}" "${USERDATA_MNT}"; then
    log "WARN: failed to mount userdata (${USERDATA_DEV}); booting without persistent overlays"
    exit 0
fi

if ! mount_overlay etc etc || ! mount_overlay home home || ! mount_overlay var-lib var/lib; then
    log "WARN: persistent overlay setup is incomplete; removing partial mounts"
    umount "${ROOT_MNT}/var/lib" 2>/dev/null || true
    umount "${ROOT_MNT}/home" 2>/dev/null || true
    umount "${ROOT_MNT}/etc" 2>/dev/null || true
    umount "${USERDATA_MNT}" 2>/dev/null || true
fi
