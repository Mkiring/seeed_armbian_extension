#!/bin/sh

# initramfs-tools hook: add OTA runtime tools into initramfs

set -e


. /usr/share/initramfs-tools/hook-functions

echo "[99-copy-tools] adding OTA runtime tools into initramfs..." >&2

# ===== rm =====
if [ -x /usr/bin/rm ]; then
    copy_exec /usr/bin/rm /usr/bin
fi

# ===== cp =====
if [ -x /usr/bin/cp ]; then
    copy_exec /usr/bin/cp /usr/bin
fi

# ===== tar =====
if [ -x /usr/bin/tar ]; then
    copy_exec /usr/bin/tar /usr/bin
fi

# ===== gzip / gunzip =====
if [ -x /usr/bin/gzip ]; then
    copy_exec /usr/bin/gzip /usr/bin
    copy_exec /usr/bin/gunzip /usr/bin
fi

# ===== sed =====
if [ -x /usr/bin/sed ]; then
    copy_exec /usr/bin/sed /usr/bin
fi

# ===== find =====
if [ -x /usr/bin/find ]; then
    copy_exec /usr/bin/find /usr/bin
fi

# ===== grep =====
if [ -x /usr/bin/grep ]; then
    copy_exec /usr/bin/grep /usr/bin
fi

# ===== tail =====
if [ -x /usr/bin/tail ]; then
    copy_exec /usr/bin/tail /usr/bin
fi

# ===== date =====
if [ -x /usr/bin/date ]; then
    copy_exec /usr/bin/date /usr/bin
fi

# ===== sync =====
if [ -x /usr/bin/sync ]; then
    copy_exec /usr/bin/sync /usr/bin
fi

# ===== awk =====
if [ -x /usr/bin/awk ]; then
    copy_exec /usr/bin/awk /usr/bin
fi

if [ -f /usr/share/armbian-ota/persist.sh ]; then
    mkdir -p "${DESTDIR}/usr/share/armbian-ota"
    cp -p /usr/share/armbian-ota/persist.sh "${DESTDIR}/usr/share/armbian-ota/persist.sh"
fi

if [ -f /usr/share/armbian-ota/preserve.sh ]; then
    mkdir -p "${DESTDIR}/usr/share/armbian-ota"
    cp -p /usr/share/armbian-ota/preserve.sh "${DESTDIR}/usr/share/armbian-ota/preserve.sh"
fi

if [ -f /usr/share/armbian-ota/state.sh ]; then
    mkdir -p "${DESTDIR}/usr/share/armbian-ota"
    cp -p /usr/share/armbian-ota/state.sh "${DESTDIR}/usr/share/armbian-ota/state.sh"
fi
