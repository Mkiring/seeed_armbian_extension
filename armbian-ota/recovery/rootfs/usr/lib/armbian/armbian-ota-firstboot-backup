#!/bin/sh
#
# First-boot partial backup (design section 3.4): seed the rollback safety
# net before the first OTA ever runs. Plain layouts archive /boot; secure
# layouts dump the raw FIT boot partition. The rootfs is NOT archived (a
# full dump costs several minutes and hundreds of MB) -- the flag
# BACKUP_PARTIAL=1 in the userdata state makes a rollback boot-only, which
# is exactly right for a factory rootfs.
#
# Idempotent: exits immediately when a backup already exists.

. /usr/share/armbian-ota/find-userdata.sh 2>/dev/null || {
    echo "firstboot-backup: find-userdata helper missing" >&2
    exit 1
}

USERDATA_MNT=/run/armbian-ota-userdata
TRANSACTION="${USERDATA_MNT}/ota-recovery"
BACKUP_DIR="${TRANSACTION}/backup"
STATE_FILE="${TRANSACTION}/state/ota-state.env"

log() { echo "firstboot-backup: $*"; }

find_userdata_partition() {
    if [ -b /dev/mapper/armbian-userdata ]; then
        echo /dev/mapper/armbian-userdata
        return 0
    fi
    # overlayroot layout: the lower-layer rootfs partition is mounted at
    # /media/root-ro; anchor the sibling userdata to its disk so a clone
    # disk with the same PARTLABEL never wins.
    lower_src="$(findmnt -n -o SOURCE /media/root-ro 2>/dev/null || true)"
    if [ -n "${lower_src}" ]; then
        dev="$(find_user_data__partition_for_root "${lower_src}" 2>/dev/null || true)"
        [ -n "$dev" ] && { echo "$dev"; return 0; }
    fi
    blkid -t PARTLABEL=userdata -o device 2>/dev/null | head -n1
}

# True when $1 starts with the big-endian FIT magic 0xd00dfeed. Guards the
# raw dump: on odd layouts (plain image whose /boot failed to mount) the
# PARTLABEL=boot lookup can surface the ext4 boot partition, and dumping
# that as boot.itb would stage a worthless net.
fit_magic_ok() {
    [ "$(dd if="$1" bs=4 count=4 2>/dev/null | od -An -tx1 | tr -d ' \n')" = "d00dfeed" ]
}

mkdir -p "${USERDATA_MNT}"
USERDATA_DEV="$(find_userdata_partition)"
if [ -z "${USERDATA_DEV}" ] || ! mount -t ext4 "${USERDATA_DEV}" "${USERDATA_MNT}"; then
    log "cannot mount userdata (${USERDATA_DEV:-none}), skipping backup seed"
    exit 0
fi

cleanup() {
    umount "${USERDATA_MNT}" 2>/dev/null || true
}
trap cleanup EXIT

[ -d "${BACKUP_DIR}" ] && { log "backup already exists, nothing to do"; exit 0; }

mkdir -p "${BACKUP_DIR}" "${TRANSACTION}/state"

# Secure-boot layouts carry the boot payload as a raw FIT partition
# (PARTNAME=boot); plain layouts have an ext4 boot partition mounted at
# /boot. Detect via the running mount.
if findmnt -n -o FSTYPE /boot 2>/dev/null | grep -q ext; then
    if tar -czf "${BACKUP_DIR}/boot.tar.gz" -C /boot .; then
        log "plain backup created: ${BACKUP_DIR}/boot.tar.gz ($(du -h "${BACKUP_DIR}/boot.tar.gz" | cut -f1))"
    else
        log "ERROR: failed to archive /boot; removing partial"
        rm -rf "${BACKUP_DIR}"
        exit 1
    fi
else
    RAW_BOOT_DEV="$(lsblk -no PATH,PARTLABEL 2>/dev/null | awk '$2=="boot"{print $1; exit}')"
    if [ -n "${RAW_BOOT_DEV}" ] && [ -b "${RAW_BOOT_DEV}" ]; then
        if dd if="${RAW_BOOT_DEV}" of="${BACKUP_DIR}/boot.itb" bs=4M status=none && fit_magic_ok "${BACKUP_DIR}/boot.itb"; then
            log "secure backup created: ${BACKUP_DIR}/boot.itb ($(du -h "${BACKUP_DIR}/boot.itb" | cut -f1))"
        else
            log "ERROR: raw boot dump failed or is not a FIT image; removing partial"
            rm -rf "${BACKUP_DIR}"
            exit 1
        fi
    else
        log "no ext4 /boot and no PARTNAME=boot raw partition; skipping backup seed"
        exit 0
    fi
fi

# Seed or patch the transaction state: BACKUP_PARTIAL=1 tells the rollback
# path the rootfs is still factory-fresh (boot-only rollback).
if [ -f "${STATE_FILE}" ]; then
    sed -i 's/^BACKUP_PARTIAL=.*/BACKUP_PARTIAL=1/' "${STATE_FILE}" 2>/dev/null ||
        printf 'BACKUP_PARTIAL=1\n' >> "${STATE_FILE}"
else
    mkdir -p "${TRANSACTION}/state"
    printf '# Armbian OTA runtime state\nOTA_MODE=recovery\nSTATUS=success\nBACKUP_PARTIAL=1\n' \
        > "${STATE_FILE}"
fi
sync
log "partial backup seeded (BACKUP_PARTIAL=1)"
