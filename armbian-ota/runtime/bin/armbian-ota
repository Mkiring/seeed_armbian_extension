#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -f "${SCRIPT_DIR}/../lib/common.sh" ]; then
    OTA_RUNTIME_DIR="$(cd "${SCRIPT_DIR}/../lib" && pwd)"
    OTA_SOURCE_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
elif [ -f /usr/share/armbian-ota/common.sh ]; then
    OTA_RUNTIME_DIR="/usr/share/armbian-ota"
    OTA_SOURCE_ROOT=""
else
    echo "ERROR: Cannot find OTA runtime libraries" >&2
    exit 1
fi

export OTA_RUNTIME_DIR
export OTA_SOURCE_ROOT

. "${OTA_RUNTIME_DIR}/common.sh"

[ -f "${OTA_RUNTIME_DIR}/persist.sh" ] && . "${OTA_RUNTIME_DIR}/persist.sh"
[ -f "${OTA_RUNTIME_DIR}/preserve.sh" ] && . "${OTA_RUNTIME_DIR}/preserve.sh"

HAS_AB_BACKEND=0
HAS_RECOVERY_BACKEND=0

load_backend() {
    local mode="$1" src

    for src in "${OTA_RUNTIME_DIR}/backend-${mode}.sh" "${OTA_SOURCE_ROOT:+${OTA_SOURCE_ROOT}/${mode}/backend.sh}"; do
        [ -f "${src}" ] || continue
        . "${src}"
        case "${mode}" in
            ab) HAS_AB_BACKEND=1 ;;
            recovery) HAS_RECOVERY_BACKEND=1 ;;
        esac
        return 0
    done
}

require_mode_backend() {
    local mode="$1"

    case "$mode" in
        ab)
            [ "${HAS_AB_BACKEND}" -eq 1 ] || error_exit "AB OTA backend is not installed on this firmware"
            ;;
        recovery)
            [ "${HAS_RECOVERY_BACKEND}" -eq 1 ] || error_exit "Recovery OTA backend is not installed on this firmware"
            ;;
        *) error_exit "Unsupported mode: ${mode}" ;;
    esac
}

for mode in ab recovery; do
    load_backend "${mode}"
done
unset mode

parse_start_args() {
    OTA_CLI_MODE=""
    OTA_CLI_PACKAGE=""

    while [ $# -gt 0 ]; do
        case "$1" in
            -*)
                error_exit "Unknown option: $1"
                ;;
            *)
                OTA_CLI_PACKAGE="$1"
                shift
                ;;
        esac
    done

    [ -n "${OTA_CLI_PACKAGE}" ] || error_exit "start requires an OTA package path"
}

normalize_yes_no() {
    case "$1" in
        yes|true|1) echo "yes" ;;
        no|false|0) echo "no" ;;
        *) return 1 ;;
    esac
}

detect_device_encryption() {
    local mode="$1" label partlabel dev type

    if [ "${mode}" = "ab" ]; then
        # Encrypted A/B images put the filesystem label inside the LUKS
        # container. Resolve the outer devices by their stable GPT labels
        # before checking their type, otherwise blkid cannot find a closed
        # rootfs_a/rootfs_b container by the inner ext4 label.
        for partlabel in rootfs_a rootfs_b; do
            dev="$(blkid -t PARTLABEL="${partlabel}" -o device 2>/dev/null | head -n1 || true)"
            [ -n "${dev}" ] || continue
            type="$(blkid -o value -s TYPE "${dev}" 2>/dev/null || true)"
            [ "${type}" = "crypto_LUKS" ] && echo "yes" && return 0
        done

        # Keep support for older A/B layouts where the root filesystem label
        # is directly visible on the raw partition.
        for label in armbi_roota armbi_rootb; do
            dev="$(blkid -t LABEL="${label}" -o device 2>/dev/null | head -n1 || true)"
            [ -n "${dev}" ] || continue
            type="$(blkid -o value -s TYPE "${dev}" 2>/dev/null || true)"
            [ "${type}" = "crypto_LUKS" ] && echo "yes" && return 0
        done
        echo "no"
        return 0
    fi

    if blkid -t TYPE=crypto_LUKS >/dev/null 2>&1 || [ -e /dev/mapper/armbian-root ]; then
        echo "yes"
    else
        echo "no"
    fi
}

detect_start_metadata() {
    local package_path="$1"
    local package_mode package_encrypted package_encrypted_raw device_encrypted

    [ -f "${package_path}" ] || error_exit "OTA package not found: ${package_path}"
    load_package_env_metadata "${package_path}" || error_exit "OTA package metadata missing package.env"

    package_mode="$(package_env_get_value "OTA_MODE" || true)"
    [ -n "${package_mode}" ] || error_exit "OTA package metadata missing OTA_MODE; cannot detect OTA mode"

    case "${package_mode}" in
        ab|recovery) ;;
        *) error_exit "Invalid OTA_MODE in package metadata: ${package_mode} (expected ab or recovery)" ;;
    esac

    OTA_CLI_MODE="${package_mode}"

    package_encrypted_raw="$(package_env_get_value "OTA_ENCRYPTED" || true)"
    package_encrypted_raw="${package_encrypted_raw:-no}"

    package_encrypted="$(normalize_yes_no "${package_encrypted_raw}")" ||
        error_exit "Invalid OTA_ENCRYPTED in package metadata: ${package_encrypted_raw} (expected yes or no)"

    ensure_command blkid
    device_encrypted="$(detect_device_encryption "${OTA_CLI_MODE}")"
    if [ "${package_encrypted}" != "${device_encrypted}" ]; then
        error_exit "OTA package encryption mismatch: package=${package_encrypted}, device=${device_encrypted}"
    fi
}

call_mode_action() {
    local mode="$1"
    local action="$2"
    local package="${3:-}"
    local fn="${mode}_${action//-/_}"

    require_mode_backend "${mode}"
    case "${action}" in
        start) fn="${mode}_start_ota" ;;
        status|mark-success|rollback) ;;
        *) error_exit "Unsupported action: ${action}" ;;
    esac

    case "${action}" in
        start) "${fn}" "${package}" ;;
        *) "${fn}" ;;
    esac
}

switch_ab_slot() {
    local target_slot="$1"

    ensure_root
    require_mode_backend "ab"
    ab_switch_slot "${target_slot}"
}

dispatch_by_state_mode() {
    local action="$1"
    local current_mode
    current_mode="$(state_get OTA_MODE)"

    case "${current_mode}" in
        ab|recovery) call_mode_action "${current_mode}" "${action}"; return ;;
    esac

    if [ "${action}" = "status" ]; then
        echo "=== Armbian OTA Status ==="
        echo "Mode: unknown"
        echo "Status: $(state_get STATUS)"
        exit 0
    fi

    error_exit "No OTA mode recorded in ${OTA_STATE_FILE}. Start an OTA first."
}

case "${1:-}" in
    start)
        shift
        ensure_root
        parse_start_args "$@"
        detect_start_metadata "${OTA_CLI_PACKAGE}"
        call_mode_action "${OTA_CLI_MODE}" "start" "${OTA_CLI_PACKAGE}"
        ;;
    status)
        state_init
        dispatch_by_state_mode "status"
        ;;
    mark-success)
        ensure_root
        state_init
        dispatch_by_state_mode "mark-success"
        ;;
    rollback)
        ensure_root
        state_init
        dispatch_by_state_mode "rollback"
        ;;
    switch-slot)
        shift
        switch_ab_slot "${1:-}"
        ;;
    *)
        cat <<'EOF'
Usage:
  armbian-ota start <ota-package.tar.gz>
  armbian-ota status
  armbian-ota mark-success
  armbian-ota switch-slot [a|b]
EOF
        exit 1
        ;;
esac
