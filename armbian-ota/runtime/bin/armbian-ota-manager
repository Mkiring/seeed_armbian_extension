#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNTIME_DIR="/usr/share/armbian-ota"
RUNTIME_CLI="/usr/sbin/armbian-ota"

if [ -x "${SCRIPT_DIR}/armbian-ota" ]; then
    RUNTIME_CLI="${SCRIPT_DIR}/armbian-ota"
    RUNTIME_DIR="${SCRIPT_DIR}/../lib"
fi

detect_mode() {
    if [ -n "${OTA_MANAGER_MODE:-}" ]; then
        echo "${OTA_MANAGER_MODE}"
        return 0
    fi
    if [ -f "${RUNTIME_DIR}/backend-ab.sh" ] && [ ! -f "${RUNTIME_DIR}/backend-recovery.sh" ]; then
        echo "ab"
        return 0
    fi
    if [ -f "${RUNTIME_DIR}/backend-recovery.sh" ] && [ ! -f "${RUNTIME_DIR}/backend-ab.sh" ]; then
        echo "recovery"
        return 0
    fi
    return 1
}

mode="$(detect_mode || true)"
case "${mode}" in
    ab|recovery) ;;
    *)
        echo "Unable to determine OTA mode; set OTA_MANAGER_MODE=ab or OTA_MANAGER_MODE=recovery" >&2
        exit 1
        ;;
esac

case "${1:-}" in
    prepare)
        if [ "${mode}" != "recovery" ]; then
            echo "prepare is only supported in recovery mode" >&2
            exit 1
        fi
        exec "${RUNTIME_CLI}" start --mode="${mode}" "$2"
        ;;
    start)
        exec "${RUNTIME_CLI}" start --mode="${mode}" "$2"
        ;;
    status)
        exec "${RUNTIME_CLI}" status
        ;;
    mark-success)
        exec "${RUNTIME_CLI}" mark-success
        ;;
    rollback)
        exec "${RUNTIME_CLI}" rollback
        ;;
    *)
        if [ "${mode}" = "recovery" ]; then
            echo "Usage: $0 {prepare|start|status|mark-success|rollback} [package]" >&2
        else
            echo "Usage: $0 {start|status|mark-success|rollback} [package]" >&2
        fi
        exit 1
        ;;
esac
