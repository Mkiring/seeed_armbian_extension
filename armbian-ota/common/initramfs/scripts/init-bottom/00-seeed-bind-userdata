#!/bin/sh
# Initramfs init-bottom script: create the stable /dev/armbian-userdata
# symlink pointing at the userdata partition that lives on the same physical
# disk as the rootfs, and record the same-disk boot partition anchor for
# zz-seeed-mount-boot. Runs BEFORE the overlayroot init-bottom hook so the
# overlayroot config can use dev=/dev/armbian-userdata and avoid the
# multi-disk duplicate-UUID/LABEL races on udev's /dev/disk/by-* symlinks.
#
# Behaviour:
#   * If /dev/mapper/armbian-userdata already exists (encrypted case, unlocked
#     earlier by init-top/0-decryption-disk), symlink to it, derive the boot
#     anchor from the mapper's backing partition, and exit.
#   * Otherwise (unencrypted), resolve the root from the initramfs ROOT
#     variable (anchored to the boot disk by init-top/armbian-bootdev-root
#     when the armbian.bootdev token is present), falling back to root= from
#     /proc/cmdline; then anchor the userdata and boot partitions to that
#     disk.
#   * If anything fails, log loudly but do not abort boot: the overlayroot
#     hook will fall back to its own dev= resolution, preserving current
#     behaviour.

PREREQ=""
prereqs() {
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

HELPER=/usr/share/armbian-ota/find-userdata.sh
if [ -r "${HELPER}" ]; then
    # shellcheck source=/usr/share/armbian-ota/find-userdata.sh
    . "${HELPER}"
else
    echo "[seeed-bind-userdata] ${HELPER} missing; skipping" >&2
    exit 0
fi

LINK=/dev/armbian-userdata

log() { echo "[seeed-bind-userdata] $*"; }
warn() { echo "[seeed-bind-userdata] WARN: $*" >&2; }

# Record the same-disk ext4 boot partition for zz-seeed-mount-boot, which
# mounts /boot after overlayroot assembled the overlay. The anchor is passed
# through /run (tmpfs, shared by every initramfs stage). fstab must NOT
# reference this mount: UUID sources flip between dd-cloned disks through
# udev's duplicate-UUID symlinks, and hand-made /dev symlinks never satisfy
# systemd's udev-backed device unit. Raw-FIT (secure boot) layouts carry no
# ext4 boot partition, so a missing or non-ext4 candidate records nothing.
record_boot_anchor() {
    anchor_root="$1"
    [ -n "${anchor_root}" ] || return 0

    boot_part="$(find_user_data__partlabel_on_root_disk "${anchor_root}" boot 2>/dev/null || true)"
    if [ -n "${boot_part}" ] && [ "$(blkid -s TYPE -o value "${boot_part}" 2>/dev/null)" = "ext4" ]; then
        mkdir -p /run 2>/dev/null || true
        printf '%s\n' "${boot_part}" > /run/armbian-boot-part
        log "boot anchor recorded: ${boot_part}"
    fi
}

# Encrypted case: mapper already set up by 0-decryption-disk in init-top.
# The userdata mapper's backing partition names the boot disk, so the /boot
# anchor is derived from it directly -- encrypted layouts mount the same
# ext4 boot partition and are exposed to the same duplicate-UUID race.
if [ -b /dev/mapper/armbian-userdata ]; then
    ln -sf /dev/mapper/armbian-userdata "${LINK}"
    log "linked ${LINK} -> /dev/mapper/armbian-userdata (encrypted)"
    if command -v dmsetup >/dev/null 2>&1; then
        enc_backing="$(dmsetup deps -o devname armbian-userdata 2>/dev/null | sed -n 's/.*(\([^ )]*\)).*/\1/p' | head -n1)"
        [ -n "${enc_backing}" ] && record_boot_anchor "/dev/${enc_backing}"
    fi
    exit 0
fi

root_dev=""

# Prefer the initramfs-resolved ROOT: after the init-top bootdev anchor wrote
# /conf/param.conf, /init re-exports ROOT as the concrete partition on the
# disk U-Boot booted from. Re-parsing root= from /proc/cmdline instead would
# go through udev's /dev/disk/by-uuid symlink, which flips between cloned
# disks with duplicate UUIDs and can put the overlay upper layer on another
# disk than the anchored lower layer.
case "${ROOT:-}" in
    /dev/*)
        root_dev="${ROOT}"
        ;;
    UUID=*|PARTUUID=*|LABEL=*)
        root_dev="$(find_user_data__resolve_root_token "${ROOT}" 2>/dev/null || true)"
        ;;
esac

if [ -z "${root_dev}" ]; then
    root_dev="$(find_user_data__root_dev_from_cmdline)" || {
        warn "could not resolve root= from cmdline; skipping"
        exit 0
    }
fi

# When root= resolves to a LUKS mapper (auto-decrypt case where the unlocked
# ext4 is the root), the mapper's parent disk has to be found by looking at
# the backing LUKS partition. Defer to dmsetup if available; otherwise skip.
case "${root_dev}" in
    /dev/mapper/*)
        if command -v dmsetup >/dev/null 2>&1; then
            backing="$(dmsetup deps -o devname "${root_dev#/dev/mapper/}" 2>/dev/null | sed -n 's/.*(\([^ )]*\)).*/\1/p' | head -n1)"
            if [ -n "${backing}" ]; then
                root_dev="/dev/${backing}"
            fi
        fi
        ;;
esac

userdata_part="$(find_user_data__partition_for_root "${root_dev}")" || {
    warn "no PARTLABEL=userdata partition on the same disk as root=${root_dev}; skipping"
    exit 0
}

# If the found partition is itself LUKS, the encrypted handler above should
# have produced the mapper. If it didn't (e.g. decryption-disk.sh hasn't run
# or failed), we can't fabricate it here -- leave the symlink absent and let
# overlayroot's own fallback deal with it.
fstype="$(blkid -s TYPE -o value "${userdata_part}" 2>/dev/null || true)"
if [ "${fstype}" = "crypto_LUKS" ]; then
    warn "${userdata_part} is LUKS but mapper not available; skipping"
    exit 0
fi

ln -sf "${userdata_part}" "${LINK}"
log "linked ${LINK} -> ${userdata_part} (root=${root_dev})"

record_boot_anchor "${root_dev}"

exit 0
