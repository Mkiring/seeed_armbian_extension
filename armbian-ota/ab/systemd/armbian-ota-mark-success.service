[Unit]
Description=Armbian AB OTA Mark Success
Documentation=https://docs.armbian.com
DefaultDependencies=no
After=armbian-ota-firstboot.service

[Service]
Type=oneshot
ExecCondition=/bin/sh -c 'test -f /var/lib/armbian-ota/ota-state.env && grep -q "^OTA_MODE=ab$" /var/lib/armbian-ota/ota-state.env && grep -Eq "^STATUS=(ready_to_boot|boot_verifying)$" /var/lib/armbian-ota/ota-state.env'
ExecStart=/usr/sbin/armbian-ota mark-success
RemainAfterExit=yes
TimeoutStartSec=60
StandardOutput=journal+console
StandardError=journal+console

# Only run if an AB OTA boot is pending verification
# This will automatically mark successful boot and clear the flag

[Install]
# Started by armbian-ota-firstboot.service after health check succeeds.
