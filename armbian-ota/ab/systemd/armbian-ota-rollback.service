[Unit]
Description=Armbian AB OTA Rollback on Failure
Documentation=https://docs.armbian.com
DefaultDependencies=no
After=armbian-ota-firstboot.service
ConditionPathExists=/var/lib/armbian-ota/ota-state.env

[Service]
Type=oneshot
ExecCondition=/usr/bin/grep -qxF OTA_MODE=ab /var/lib/armbian-ota/ota-state.env
ExecCondition=/usr/bin/grep -Eq '^STATUS=(ready_to_boot|boot_verifying)$' /var/lib/armbian-ota/ota-state.env
ExecStart=/usr/sbin/armbian-ota rollback
TimeoutStartSec=60
StandardOutput=journal+console
StandardError=journal+console

# This service runs ONLY when health check (firstboot) fails
# It is NOT enabled directly - only triggered via OnFailure
# The rollback command also checks ota_in_progress flag
# It will rollback to the previous working slot if OTA was in progress

[Install]
# No WantedBy - this service is only started via OnFailure trigger
