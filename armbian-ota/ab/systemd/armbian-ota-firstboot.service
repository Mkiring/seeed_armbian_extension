[Unit]
Description=Armbian AB OTA First Boot Health Check
Documentation=https://docs.armbian.com
DefaultDependencies=no
After=network-online.target
Wants=network-online.target
Before=armbian-ota-mark-success.service
OnFailure=armbian-ota-rollback.service

[Service]
Type=oneshot
ExecCondition=/bin/sh -c 'test -f /var/lib/armbian-ota/ota-state.env && grep -q "^OTA_MODE=ab$" /var/lib/armbian-ota/ota-state.env && grep -Eq "^STATUS=(ready_to_boot|boot_verifying)$" /var/lib/armbian-ota/ota-state.env'
ExecStart=/usr/lib/armbian/armbian-ota-health-check
RemainAfterExit=yes
TimeoutStartSec=300
StandardOutput=journal+console
StandardError=journal+console

# Health check only runs while an AB OTA boot is pending verification
# If it passes, mark-success service will be triggered
# If it fails, rollback service will be triggered

[Install]
WantedBy=multi-user.target
