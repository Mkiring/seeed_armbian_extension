#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "${SCRIPT_DIR}/../../runtime/lib/common.sh" ]; then
    . "${SCRIPT_DIR}/../../runtime/lib/common.sh"
elif [ -f /usr/share/armbian-ota/common.sh ]; then
    . /usr/share/armbian-ota/common.sh
else
    echo "ERROR: Cannot find OTA common library" >&2
    exit 1
fi

resolve_physical_part_dev() {
    local dev="$1" pkname

    case "${dev}" in
        /dev/mapper/*|/dev/dm-*)
            pkname="$(lsblk -no PKNAME "${dev}" 2>/dev/null | head -n1 || true)"
            [ -n "${pkname}" ] && echo "/dev/${pkname}"
            ;;
        *)
            echo "${dev}"
            ;;
    esac
}

get_current_root_dev() {
    local dev

    dev="$(findmnt -n -o SOURCE /media/root-ro 2>/dev/null || true)"
    [ -n "${dev}" ] || dev="$(findmnt -n -o SOURCE / 2>/dev/null || true)"
    [ -n "${dev}" ] && echo "${dev}"
}

get_uuid_by_label() {
    local label="$1" dev

    dev="$(blkid -t LABEL="${label}" -o device 2>/dev/null | head -n1 || true)"
    [ -n "${dev}" ] || return 0
    blkid -s UUID -o value "${dev}" 2>/dev/null | head -n1 || true
}

detect_current_slot() {
    local root_dev root_part partlabel root_uuid root_a_uuid root_b_uuid

    root_dev="$(get_current_root_dev)"
    [ -n "${root_dev}" ] || return 1

    root_part="$(resolve_physical_part_dev "${root_dev}" || true)"
    if [ -n "${root_part}" ]; then
        partlabel="$(blkid -s PARTLABEL -o value "${root_part}" 2>/dev/null || true)"
        case "${partlabel}" in
            rootfs_a) echo "a"; return 0 ;;
            rootfs_b) echo "b"; return 0 ;;
        esac
    fi

    root_uuid="$(blkid -s UUID -o value "${root_dev}" 2>/dev/null | head -n1 || true)"
    root_a_uuid="$(get_uuid_by_label "armbi_roota")"
    root_b_uuid="$(get_uuid_by_label "armbi_rootb")"

    if [ -n "${root_uuid}" ] && [ "${root_uuid}" = "${root_a_uuid}" ]; then
        echo "a"
        return 0
    fi
    if [ -n "${root_uuid}" ] && [ "${root_uuid}" = "${root_b_uuid}" ]; then
        echo "b"
        return 0
    fi

    return 1
}

require_basic_system_health() {
    local root_opts

    [ -r /proc/version ] || {
        log_error "/proc/version is not readable"
        return 1
    }

    mountpoint -q /proc && mountpoint -q /sys && mountpoint -q /dev || {
        log_error "required pseudo filesystems are not mounted"
        return 1
    }

    root_opts="$(findmnt -n -o OPTIONS / 2>/dev/null || true)"
    case ",${root_opts}," in
        *,rw,*) ;;
        *)
            log_error "root filesystem is not writable"
            return 1
            ;;
    esac

    log_info "Kernel version: $(uname -r)"
}

main() {
    local expected_slot current_slot

    init_logging
    state_init

    if [ "$(state_get OTA_MODE)" != "ab" ]; then
        log_info "Current OTA mode is not ab, skipping health check"
        exit 0
    fi

    case "$(state_get STATUS)" in
        ready_to_boot|boot_verifying) ;;
        *)
            log_info "A/B OTA state is not pending verification, skipping health check"
            exit 0
            ;;
    esac

    if ! command -v fw_printenv >/dev/null 2>&1; then
        log_error "fw_printenv not found"
        exit 1
    fi

    if [ "$(fw_printenv -n ota_in_progress 2>/dev/null || echo 0)" != "1" ]; then
        log_info "ota_in_progress is not set, skipping health check"
        exit 0
    fi

    state_mark_status "boot_verifying"
    log_info "Running A/B OTA health check"

    expected_slot="$(state_get TARGET_SLOT)"
    current_slot="$(detect_current_slot || true)"

    if [ -z "${current_slot}" ]; then
        log_error "Cannot determine current AB slot"
        exit 1
    fi
    if [ -n "${expected_slot}" ] && [ "${expected_slot}" != "${current_slot}" ]; then
        log_error "Slot verification failed: expected target slot=${expected_slot}, current slot=${current_slot}"
        exit 1
    fi

    require_basic_system_health || exit 1

    log_info "A/B OTA health check passed"
}

main "$@"
