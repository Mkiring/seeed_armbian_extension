#!/bin/bash

set -euo pipefail

SERVICE_NAME="armbian-resize-userdata.service"
USERDATA_PARTLABEL="userdata"
USERDATA_FSLABEL="armbi_usrdata"
ALIGN_BYTES=$((16 * 1024 * 1024))
RETRY_EXIT_STATUS=75

log() {
    echo "[resize-userdata] $*"
}

warn() {
    echo "[resize-userdata] WARN: $*" >&2
}

fail() {
    echo "[resize-userdata] ERROR: $*" >&2
    exit 1
}

require_commands() {
    local command

    for command in blkid lsblk parted partprobe partx resize2fs script udevadm; do
        command -v "${command}" >/dev/null 2>&1 ||
            fail "required command not found: ${command}"
    done
}

get_parent_disk_dev() {
    local partdev="$1" pkname base

    pkname="$(lsblk -no PKNAME "${partdev}" 2>/dev/null | head -n1 || true)"
    if [ -n "${pkname}" ]; then
        echo "/dev/${pkname}"
        return 0
    fi

    base="$(basename "${partdev}")"
    case "${base}" in
        nvme*n*p[0-9]*|mmcblk*p[0-9]*) echo "/dev/${base%p[0-9]*}" ;;
        sd*[0-9]*) echo "/dev/${base%%[0-9]*}" ;;
        *) return 1 ;;
    esac
}

get_partition_number() {
    local partdev="$1" base

    base="$(basename "${partdev}")"
    case "${base}" in
        nvme*n*p[0-9]*|mmcblk*p[0-9]*) echo "${base##*p}" ;;
        sd*[0-9]*) echo "${base##*[!0-9]}" ;;
        *) return 1 ;;
    esac
}

parted_field() {
    local diskdev="$1" partnum="$2" field="$3"

    # -f repairs the backup GPT header after a small image has been written
    # to a larger disk. Without it, parted refuses every later resize action.
    parted -s -f -m "${diskdev}" unit s print |
        awk -F: -v part="${partnum}" -v field="${field}" \
            'NR >= 3 && $1 == part { gsub(/s$/, "", $field); print $field; exit }'
}

partition_after_start() {
    local diskdev="$1" partstart="$2"

    parted -s -f -m "${diskdev}" unit s print |
        awk -F: -v start="${partstart}" \
            'NR >= 3 { gsub(/s$/, "", $2); if (($2 + 0) > start) print $1 }'
}

resize_partition_to_end() {
    local partdev="$1" diskdev partnum partstart partend capacity sector_size lastsector trailing expected_size actual_size

    [ "$(lsblk -no TYPE "${partdev}" 2>/dev/null | head -n1)" = "part" ] ||
        fail "${partdev} is not a partition"

    diskdev="$(get_parent_disk_dev "${partdev}")" ||
        fail "failed to detect parent disk for ${partdev}"
    partnum="$(get_partition_number "${partdev}")" ||
        fail "failed to detect partition number for ${partdev}"

    partstart="$(parted_field "${diskdev}" "${partnum}" 2)"
    partend="$(parted_field "${diskdev}" "${partnum}" 3)"
    [ -n "${partstart}" ] && [ -n "${partend}" ] ||
        fail "failed to read ${partdev} boundaries"

    trailing="$(partition_after_start "${diskdev}" "${partstart}")"
    [ -z "${trailing}" ] ||
        fail "${partdev} is not the last partition; partition(s) after it: ${trailing}"

    capacity="$(parted -s -f -m "${diskdev}" unit s print | awk -F: 'NR == 2 { gsub(/s$/, "", $2); print $2 }')"
    sector_size="$(parted -s -f -m "${diskdev}" unit s print | awk -F: 'NR == 2 { print $4 }')"
    [ -n "${capacity}" ] && [ -n "${sector_size}" ] ||
        fail "failed to read ${diskdev} geometry"

    # Keep the end below the disk's final alignment block.  This safely leaves
    # room for GPT backup metadata even when the disk capacity is aligned.
    lastsector=$((capacity - 1))
    lastsector=$((lastsector - (lastsector % (ALIGN_BYTES / sector_size)) - 1))

    log "partition=${partdev} disk=${diskdev} number=${partnum} start=${partstart}s end=${partend}s target_end=${lastsector}s"

    if [ "${lastsector}" -lt "${partend}" ]; then
        fail "target end ${lastsector}s is smaller than current end ${partend}s; refusing to shrink"
    fi
    if [ "${lastsector}" -eq "${partend}" ]; then
        log "partition already uses available space"
        return 2
    fi

    # userdata is the verified final partition.  parted reads the mounted
    # partition confirmation from a TTY, so use script(1) to provide a small
    # pseudo-terminal and feed exactly one affirmative response.
    printf 'Yes\n' | script -q -e -c "parted -f ${diskdev} unit s resizepart ${partnum} ${lastsector}s" /dev/null ||
        fail "failed to resize ${partdev}"
    partprobe "${diskdev}" || warn "partprobe could not reload ${diskdev}"
    partx --update --nr "${partnum}" "${diskdev}" ||
        warn "partx could not reload ${partdev}"
    udevadm settle || true

    expected_size=$((sector_size * (lastsector - partstart + 1)))
    actual_size="$(lsblk -bno SIZE "${partdev}" 2>/dev/null | head -n1 || true)"
    if [ "${actual_size}" != "${expected_size}" ]; then
        warn "kernel has not reloaded ${partdev} size yet; retrying shortly (reboot if retries do not succeed)"
        return "${RETRY_EXIT_STATUS}"
    fi

    log "partition resized"
    return 0
}

resize_ext4_filesystem() {
    local partdev="$1" fstype

    fstype="$(blkid -s TYPE -o value "${partdev}" 2>/dev/null || true)"
    [ "${fstype}" = "ext4" ] ||
        fail "unsupported userdata filesystem: ${fstype:-unknown}"

    log "resizing ext4 filesystem on ${partdev}"
    resize2fs "${partdev}"
}

find_userdata_dev() {
    local dev

    dev="$(blkid -t PARTLABEL="${USERDATA_PARTLABEL}" -o device 2>/dev/null | head -n1 || true)"
    if [ -n "${dev}" ]; then
        echo "${dev}"
        return 0
    fi

    blkid -t LABEL="${USERDATA_FSLABEL}" -o device 2>/dev/null | head -n1 || true
}

main() {
    local userdata_dev resize_status

    require_commands

    userdata_dev="$(find_userdata_dev)"
    if [ -z "${userdata_dev}" ]; then
        warn "userdata partition not found"
        systemctl disable "${SERVICE_NAME}" >/dev/null 2>&1 || true
        return 0
    fi

    log "resizing userdata partition: ${userdata_dev}"
    resize_status=0
    resize_partition_to_end "${userdata_dev}" || resize_status=$?
    if [ "${resize_status}" -eq "${RETRY_EXIT_STATUS}" ]; then
        exit "${RETRY_EXIT_STATUS}"
    fi
    if [ "${resize_status}" -ne 0 ] && [ "${resize_status}" -ne 2 ]; then
        exit "${resize_status}"
    fi
    resize_ext4_filesystem "${userdata_dev}"

    systemctl disable "${SERVICE_NAME}" >/dev/null 2>&1 || true
}

main "$@"
