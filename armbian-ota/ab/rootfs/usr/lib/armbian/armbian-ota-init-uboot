#!/bin/bash
#
# Initialize u-boot environment for AB partition OTA
# This script modifies u-boot environment to support A/B slot boot selection
# Supports NVMe, SD card (mmc), and eMMC (mmc) storage devices
#

set -e

OTA_RUNTIME_DIR="/usr/share/armbian-ota"
AB_ENV_LIB="${OTA_RUNTIME_DIR}/ab/env.sh"
[ -r "${AB_ENV_LIB}" ] || {
    echo "ERROR: A/B U-Boot environment helper not found: ${AB_ENV_LIB}" >&2
    exit 1
}
. "${AB_ENV_LIB}"

# U-Boot environment location. The device is detected at runtime.
readonly AB_FW_ENV_OFFSET="0x3f8000"
readonly AB_FW_ENV_SIZE="0x8000"
readonly AB_FW_ENV_ERASE_SIZE="0x1000"

# Logging
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"
}

log_info() {
    log "INFO: $@"
}

log_error() {
    log "ERROR: $@" >&2
}

ensure_initial_env() {
    local initial_env="/etc/u-boot-initial-env"

    # libubootenv has no compiled-in default.  On a freshly provisioned raw
    # environment, fw_setenv needs this file to construct the first valid
    # CRC-protected image.  Do not replace an administrator-provided default.
    if [ -s "${initial_env}" ]; then
        return 0
    fi

    mkdir -p /etc
    cat > "${initial_env}" <<'EOF'
# Default values for first-time A/B U-Boot environment initialization.
boot_slot=a
boot_success=a
ota_in_progress=0
try_count=0
slot_retry_max=3
slot_retry_left=3
EOF
    chmod 0644 "${initial_env}"
    log_info "Installed fallback U-Boot default environment: ${initial_env}"
}

get_parent_disk_dev() {
    local dev="$1" pkname base
    [ -n "${dev}" ] || return 1

    pkname="$(lsblk -no PKNAME "${dev}" 2>/dev/null | head -n1)"
    if [ -n "${pkname}" ]; then
        echo "/dev/${pkname}"
        return 0
    fi

    base="$(basename "${dev}")"
    case "${base}" in
        nvme*n*p[0-9]*)
            echo "/dev/${base%p[0-9]*}"
            return 0
            ;;
        mmcblk*p[0-9]*)
            echo "/dev/${base%p[0-9]*}"
            return 0
            ;;
        sd*[0-9]*)
            echo "/dev/${base%%[0-9]*}"
            return 0
            ;;
    esac

    echo "${dev}"
}

get_partition_number_from_dev() {
    local dev="$1"
    local base
    base="$(basename "${dev}")"

    if [[ "${base}" =~ p([0-9]+)$ ]]; then
        echo "${BASH_REMATCH[1]}"
        return 0
    fi

    if [[ "${base}" =~ ([0-9]+)$ ]]; then
        echo "${BASH_REMATCH[1]}"
        return 0
    fi

    return 1
}

get_uboot_bootdev_from_part() {
    local dev="$1"
    local base
    base="$(basename "${dev}")"

    # /dev/mmcblk1p1 -> mmc 1
    if [[ "${base}" =~ ^mmcblk([0-9]+)p[0-9]+$ ]]; then
        echo "mmc ${BASH_REMATCH[1]}"
        return 0
    fi

    # /dev/nvme0n1p1 -> nvme 0
    if [[ "${base}" =~ ^nvme([0-9]+)n[0-9]+p[0-9]+$ ]]; then
        echo "nvme ${BASH_REMATCH[1]}"
        return 0
    fi

    return 1
}

get_part_uuid() {
    local dev="$1"
    [ -n "${dev}" ] || return 1
    blkid -o value -s UUID "${dev}" 2>/dev/null | head -n1
}

set_env_if_missing() {
    local key="$1" value="$2" current

    current="$(fw_printenv -n "${key}" 2>/dev/null || true)"
    if [ -z "${current}" ]; then
        fw_setenv "${key}" "${value}"
        log_info "Set ${key} to '${value}'"
    fi
}

ensure_fw_env_config() {
    local boot_part_dev="$1" fw_env_device

    fw_env_device="$(get_parent_disk_dev "${boot_part_dev}")" || {
        log_error "Failed to detect U-Boot environment device"
        return 1
    }

    mkdir -p /etc
    printf '%s %s %s %s\n' \
        "${fw_env_device}" "${AB_FW_ENV_OFFSET}" "${AB_FW_ENV_SIZE}" "${AB_FW_ENV_ERASE_SIZE}" \
        > /etc/fw_env.config
    log_info "Installed fw_env.config: ${fw_env_device} ${AB_FW_ENV_OFFSET} ${AB_FW_ENV_SIZE} ${AB_FW_ENV_ERASE_SIZE}"
}

detect_ab_partitions() {
    # Boot partitions use filesystem labels first; raw FIT boot partitions use
    # GPT PARTLABEL. Root partitions use GPT PARTLABEL for encrypted A/B too.
    boot_a_dev="$(ab_get_part_by_label "${BOOT_A_LABEL}")"
    boot_b_dev="$(ab_get_part_by_label "${BOOT_B_LABEL}")"
    root_a_dev="$(ab_get_part_by_label "${ROOT_A_LABEL}")"
    root_b_dev="$(ab_get_part_by_label "${ROOT_B_LABEL}")"

    if [ -z "${boot_a_dev}" ] || [ -z "${boot_b_dev}" ] || [ -z "${root_a_dev}" ] || [ -z "${root_b_dev}" ]; then
        log_error "Cannot find one or more A/B partitions by label"
        log_error "boot_a=${boot_a_dev:-<none>} boot_b=${boot_b_dev:-<none>} root_a=${root_a_dev:-<none>} root_b=${root_b_dev:-<none>}"
        exit 1
    fi

    # Use detected partition mapping to support custom layouts, such as ones
    # with BIOS, EFI, or security partitions before the A/B slots.
    BOOT_A_PART=$(get_partition_number_from_dev "${boot_a_dev}" || true)
    BOOT_B_PART=$(get_partition_number_from_dev "${boot_b_dev}" || true)
    ROOT_A_PART=$(get_partition_number_from_dev "${root_a_dev}" || true)
    ROOT_B_PART=$(get_partition_number_from_dev "${root_b_dev}" || true)

    if [ -z "${BOOT_A_PART}" ] || [ -z "${BOOT_B_PART}" ] || [ -z "${ROOT_A_PART}" ] || [ -z "${ROOT_B_PART}" ]; then
        log_error "Failed to parse one or more partition numbers from device names"
        log_error "boot_a=${boot_a_dev} boot_b=${boot_b_dev} root_a=${root_a_dev} root_b=${root_b_dev}"
        exit 1
    fi
}

detect_ab_boot_configuration() {
    read -r BOOT_DEVTYPE BOOT_DEVNUM <<< "$(get_uboot_bootdev_from_part "${boot_a_dev}" || true)"
    if [ -z "${BOOT_DEVTYPE}" ] || [ -z "${BOOT_DEVNUM}" ]; then
        log_error "Unsupported boot_a device for U-Boot bootcmd generation: ${boot_a_dev}"
        exit 1
    fi

    boot_a_uuid="$(ab_get_uuid_by_label "${BOOT_A_LABEL}")"
    boot_b_uuid="$(ab_get_uuid_by_label "${BOOT_B_LABEL}")"
    root_a_uuid="$(get_part_uuid "${root_a_dev}")"
    root_b_uuid="$(get_part_uuid "${root_b_dev}")"
    boot_a_fstype="$(blkid -s TYPE -o value "${boot_a_dev}" 2>/dev/null || true)"
    boot_b_fstype="$(blkid -s TYPE -o value "${boot_b_dev}" 2>/dev/null || true)"
    AB_BOOT_MODE="filesystem"
    if [ -z "${boot_a_fstype}" ] && [ -z "${boot_b_fstype}" ]; then
        AB_BOOT_MODE="raw-fit"
    fi
    CURRENT_SLOT="$(ab_env_current_slot || echo "a")"

    log_info "Detected partition layout:"
    log_info "  boot_a: ${boot_a_dev} (partition ${BOOT_A_PART})"
    log_info "  boot_b: ${boot_b_dev} (partition ${BOOT_B_PART})"
    log_info "  root_a: ${root_a_dev} (partition ${ROOT_A_PART})"
    log_info "  root_b: ${root_b_dev} (partition ${ROOT_B_PART})"
    log_info "Detected boot media for U-Boot: ${BOOT_DEVTYPE} ${BOOT_DEVNUM}"
    log_info "Detected current slot: ${CURRENT_SLOT}"
    log_info "Detected A/B boot mode: ${AB_BOOT_MODE}"
    log_info "Partition UUIDs:"
    log_info "  boot_a: ${boot_a_uuid:-<not found>}"
    log_info "  boot_b: ${boot_b_uuid:-<not found>}"
    log_info "  root_a: ${root_a_uuid:-<not found>}"
    log_info "  root_b: ${root_b_uuid:-<not found>}"
}

configure_ab_boot_environment() {
    local orig_bootcmd

    ensure_fw_env_config "${boot_a_dev}"

    if ! fw_printenv -n orig_bootcmd >/dev/null 2>&1; then
        orig_bootcmd="$(fw_printenv -n bootcmd 2>/dev/null || true)"
        if [ -n "${orig_bootcmd}" ]; then
            fw_setenv orig_bootcmd "${orig_bootcmd}"
            log_info "Saved original bootcmd"
        fi
    fi

    set_env_if_missing boot_slot "${CURRENT_SLOT}"
    set_env_if_missing boot_success "${CURRENT_SLOT}"
    set_env_if_missing ota_in_progress 0
    set_env_if_missing try_count 0
    set_env_if_missing slot_retry_max 3
    set_env_if_missing slot_retry_left "$(fw_printenv -n slot_retry_max 2>/dev/null || echo 3)"

    AB_PREBOOT='if test "${ota_in_progress}" = "1"; then if test "${slot_retry_left}" = "0"; then setenv boot_slot ${boot_success}; setenv ota_in_progress 0; setenv slot_retry_left ${slot_retry_max}; saveenv; reset; fi; setexpr slot_retry_left ${slot_retry_left} - 1; saveenv; fi'
    AB_SCAN_DEV_FOR_BOOT_PART='if test "${devtype}" = "${ab_boot_devtype}" && test "${devnum}" = "${ab_boot_devnum}"; then if test "${boot_slot}" = "b"; then setenv devplist ${distro_bootpart_b}; else setenv devplist ${distro_bootpart_a}; fi; else part list ${devtype} ${devnum} -bootable devplist; env exists devplist || setenv devplist 1; fi; boot_android ${devtype} ${devnum}; for distro_bootpart in ${devplist}; do if fstype ${devtype} ${devnum}:${distro_bootpart} bootfstype; then run scan_dev_for_boot; fi; done'
    AB_SELECT_FIT_SLOT='if test "${boot_slot}" = "b"; then setenv boot_fit_part boot_b; else setenv boot_fit_part boot_a; fi'

    if [ "${AB_BOOT_MODE}" = "raw-fit" ]; then
        # The Rockchip boot_fit patch loads directly from boot_a or boot_b;
        # distro_bootcmd only supports filesystem-backed boot partitions.
        # Keep the kernel/initramfs aligned with the raw FIT slot selected by
        # U-Boot. The initramfs resolves rootfs_a/rootfs_b by this token,
        # avoiding a device-local LUKS UUID embedded in a signed FIT.
        AB_BOOTCMD='run ab_preboot; run ab_select_fit_slot; setenv bootargs "${bootargs} armbian.slot=${boot_slot}"; boot_fit'
    else
        AB_BOOTCMD='run ab_preboot; run distro_bootcmd; boot_fit; bootrkp'
    fi

    mkdir -p /var/lib/armbian-ota
    TEMP_ENV=$(mktemp /var/lib/armbian-ota/uboot-env.XXXXXX)
    trap 'rm -f "${TEMP_ENV:-}"' EXIT

    log_info "Set distro_bootpart_a=${BOOT_A_PART}, distro_bootpart_b=${BOOT_B_PART}, ab_boot_devtype=${BOOT_DEVTYPE}, ab_boot_devnum=${BOOT_DEVNUM}, boot_targets=${BOOT_DEVTYPE}${BOOT_DEVNUM}"

    # Keep standard distro_bootcmd scanning order. For the selected boot
    # media, scan only the slot selected by boot_slot; other media stay stock.
    {
        printf 'distro_bootpart_a=%s\n' "${BOOT_A_PART}"
        printf 'distro_bootpart_b=%s\n' "${BOOT_B_PART}"
        printf 'ab_boot_devtype=%s\n' "${BOOT_DEVTYPE}"
        printf 'ab_boot_devnum=%s\n' "${BOOT_DEVNUM}"
        printf 'boot_targets=%s%s\n' "${BOOT_DEVTYPE}" "${BOOT_DEVNUM}"
        printf 'ab_boot_mode=%s\n' "${AB_BOOT_MODE}"
        printf 'ab_preboot=%s\n' "${AB_PREBOOT}"
        printf 'ab_select_fit_slot=%s\n' "${AB_SELECT_FIT_SLOT}"
        printf 'bootcmd=%s\n' "${AB_BOOTCMD}"
        if [ "${AB_BOOT_MODE}" = "filesystem" ]; then
            printf 'scan_dev_for_boot_part=%s\n' "${AB_SCAN_DEV_FOR_BOOT_PART}"
        fi
    } > "${TEMP_ENV}"

    log_info "Modified bootcmd"
    fw_setenv -s "${TEMP_ENV}"
}

mark_uboot_initialized() {
    mkdir -p /var/lib/armbian-ota
    cat > /var/lib/armbian-ota/uboot_initialized << EOF
# u-boot AB partition environment initialized
$(date)
boot_a_part=${BOOT_A_PART}
boot_b_part=${BOOT_B_PART}
root_a_part=${ROOT_A_PART}
root_b_part=${ROOT_B_PART}
boot_a_dev=${boot_a_dev}
boot_b_dev=${boot_b_dev}
root_a_dev=${root_a_dev}
root_b_dev=${root_b_dev}
boot_devtype=${BOOT_DEVTYPE}
boot_devnum=${BOOT_DEVNUM}
boot_mode=${AB_BOOT_MODE}
boot_a_uuid=${boot_a_uuid}
boot_b_uuid=${boot_b_uuid}
root_a_uuid=${root_a_uuid}
root_b_uuid=${root_b_uuid}
EOF
}

# Check if already initialized
if [ "${1:-}" != "--force" ] && [ -f /var/lib/armbian-ota/uboot_initialized ]; then
    log_info "u-boot AB environment already initialized"
    exit 0
fi

# Check if fw_setenv/fw_printenv exists
if ! command -v fw_printenv >/dev/null 2>&1 || ! command -v fw_setenv >/dev/null 2>&1; then
    log_error "fw_printenv/fw_setenv not found"
    exit 1
fi

ensure_initial_env

log_info "=== Initializing u-boot AB partition boot environment ==="
detect_ab_partitions
detect_ab_boot_configuration
configure_ab_boot_environment
mark_uboot_initialized

log_info "=== u-boot AB environment initialization complete ==="
log_info "Please reboot for changes to take effect"
log_info "Current boot_slot: $(fw_printenv -n boot_slot)"
log_info "Current bootcmd: $(fw_printenv -n bootcmd)"

exit 0
