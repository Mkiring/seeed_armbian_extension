+function aic8800_download_file_with_cache() {
+	declare url="$1"
+	declare output_name="$2"
+	declare cached_file="${AIC8800_CACHE_DIR}/${output_name}"
+
+	if [[ -f "${cached_file}" ]]; then
+		display_alert "Using cached AIC8800 package" "${output_name}" "debug"
+	else
+		display_alert "Downloading AIC8800 package" "${output_name}" "info"
+		if ! wget --progress=dot:mega --local-encoding=UTF-8 --output-document="${cached_file}.tmp" "${url}"; then
+			rm -f "${cached_file}.tmp"
+			if [[ -f "${cached_file}" ]]; then
+				display_alert "Download failed, using cached AIC8800 package" "${output_name}" "warn"
+			else
+				exit_with_error "Failed to download ${url} and no cached file exists."
+			fi
+		else
+			mv -v "${cached_file}.tmp" "${cached_file}"
+		fi
+	fi
+
+	mkdir -p "${SDCARD}/tmp"
+	cp -v "${cached_file}" "${SDCARD}/tmp/${output_name}"
+}
