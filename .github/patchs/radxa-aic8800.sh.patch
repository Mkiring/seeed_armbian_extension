+function aic8800_download_from_github_api() {
+	declare output_name="$1"
+	declare cached_file="${AIC8800_CACHE_DIR}/${output_name}"
+	declare assets_json="${AIC8800_CACHE_DIR}/release-${latest_version}.json"
+	declare release_encoded asset_id
+	declare -a curl_auth=()
+	if [[ -n "${AIC8800_GITHUB_TOKEN:-}" ]]; then
+		curl_auth=(--header "Authorization: Bearer ${AIC8800_GITHUB_TOKEN}")
+	fi
+
+	if [[ ! -f "${assets_json}" ]]; then
+		release_encoded=$(printf '%s' "${latest_version}" | jq -sRr @uri)
+		display_alert "Fetching AIC8800 release asset metadata" "${latest_version}" "info"
+		if ! curl --fail --location --silent --show-error --connect-timeout 15 --max-time 120 \
+			"${curl_auth[@]}" \
+			"https://api.github.com/repos/radxa-pkg/aic8800/releases/tags/${release_encoded}" \
+			--output "${assets_json}.tmp" \
+			|| ! jq -e '.assets | type == "array"' "${assets_json}.tmp" > /dev/null; then
+			rm -f "${assets_json}.tmp"
+			return 1
+		fi
+		mv -v "${assets_json}.tmp" "${assets_json}"
+	fi
+
+	if ! asset_id="$(jq -e -r --arg output_name "${output_name}" \
+		'.assets[] | select(.name == $output_name) | .id' "${assets_json}")"; then
+		display_alert "AIC8800 asset missing from GitHub release" "${output_name}" "warn"
+		return 1
+	fi
+	display_alert "Downloading AIC8800 package via GitHub asset API" "${output_name} (asset ${asset_id})" "info"
+	if ! curl --fail --location --silent --show-error --connect-timeout 15 --max-time 300 \
+		"${curl_auth[@]}" --header "Accept: application/octet-stream" \
+		"https://api.github.com/repos/radxa-pkg/aic8800/releases/assets/${asset_id}" \
+		--output "${cached_file}.tmp"; then
+		rm -f "${cached_file}.tmp"
+		return 1
+	fi
+	if ! dpkg-deb --info "${cached_file}.tmp" > /dev/null 2>&1; then
+		display_alert "Downloaded AIC8800 asset is not a valid deb" "${output_name}" "warn"
+		rm -f "${cached_file}.tmp"
+		return 1
+	fi
+	mv -v "${cached_file}.tmp" "${cached_file}"
+}
+
+function aic8800_download_file_with_cache() {
+	declare url="$1"
+	declare output_name="$2"
+	declare cached_file="${AIC8800_CACHE_DIR}/${output_name}"
+
+	if [[ -f "${cached_file}" ]] && ! dpkg-deb --info "${cached_file}" > /dev/null 2>&1; then
+		display_alert "Discarding invalid cached AIC8800 package" "${output_name}" "warn"
+		rm -f "${cached_file}"
+	fi
+	if [[ ! -f "${cached_file}" ]]; then
+		display_alert "Downloading AIC8800 package" "${output_name}" "info"
+		if wget --progress=dot:mega --local-encoding=UTF-8 --tries=3 --timeout=30 --waitretry=2 \
+			--output-document="${cached_file}.tmp" "${url}" \
+			&& dpkg-deb --info "${cached_file}.tmp" > /dev/null 2>&1; then
+			mv -v "${cached_file}.tmp" "${cached_file}"
+		else
+			rm -f "${cached_file}.tmp"
+			display_alert "Release download failed, trying the GitHub asset API" "${output_name}" "warn"
+		fi
+	fi
+	if [[ ! -f "${cached_file}" ]]; then
+		if ! aic8800_download_from_github_api "${output_name}"; then
+			rm -f "${cached_file}.tmp"
+			display_alert "Failed to download AIC8800 package from GitHub" "${output_name}" "err"
+			return 1
+		fi
+	fi
+
+	mkdir -p "${SDCARD}/tmp"
+	cp -v "${cached_file}" "${SDCARD}/tmp/${output_name}"
+}
