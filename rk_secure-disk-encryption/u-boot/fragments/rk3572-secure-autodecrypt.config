# rk3572 secure/auto-decrypt U-Boot config fragment (rockchip v2025.04 tree).
#
# Deliberately NO CONFIG_SPL_FIT_GENERATOR override: unlike the radxa
# rk3576/rk3588 trees, this tree packs the U-Boot FIT through the SDK flow
# (scripts/fit.sh + rkbin RK3572TRUST.ini, driven by the board's
# board_uboot_spl_blobs_postprocess). fit.sh auto-enables signing when it sees
# CONFIG_FIT_SIGNATURE=y here, so applying this fragment is what turns the
# existing packing invocation into a signed one.
#
# earlycon: rk3572 UART0 (fiq-debugger console) is at 0x2c130000 -- NOT the
# rk3576 address 0x2ad40000 used in the other fragments.
CONFIG_FIT_SIGNATURE=y
CONFIG_SPL_FIT_SIGNATURE=y
CONFIG_FIT_ENABLE_RSASSA_PSS_SUPPORT=y
CONFIG_USE_BOOTARGS=y
CONFIG_BOOTARGS="earlycon=uart8250,mmio32,0x2c130000 console=ttyFIQ0 root=/dev/mapper/armbian-root rw rootwait"
