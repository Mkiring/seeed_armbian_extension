 function post_family_tweaks__recomputer_rk3576_gdm_config() {
 	[[ "${BRANCH}" == "vendor" ]] || return 0 # only for BRANCH=vendor
+	if [[ "${RECOMPUTER_GPU_STACK:-mali}" == "panfrost" ]]; then
