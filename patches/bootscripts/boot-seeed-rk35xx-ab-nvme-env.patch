diff --git a/config/bootscripts/boot-seeed-rk35xx.cmd b/config/bootscripts/boot-seeed-rk35xx.cmd
index 72859a9d3..bd30c9cdb 100644
--- a/config/bootscripts/boot-seeed-rk35xx.cmd
+++ b/config/bootscripts/boot-seeed-rk35xx.cmd
@@ -7,6 +7,48 @@
 # RK3576: 0x48200000, RK3588: 0x08200000 (set in ENV_MEM_LAYOUT_SETTINGS)
 setenv load_addr "${fdtoverlay_addr_r}"
 setenv overlay_error "false"
+
+# AB OTA environment is stored at the same fixed raw offset used by U-Boot.
+# If U-Boot was loaded from SPI or another fallback medium, import the raw
+# environment from the boot medium here and
+# redirect to the selected slot before loading kernel/rootfs parameters.
+setenv ab_env_offset_blocks 0x1fc0
+setenv ab_env_size_blocks 0x40
+setenv ab_env_size_bytes 0x8000
+if test "${devtype}" = "nvme" || test "${devtype}" = "mmc"; then
+	if test "${ab_raw_env_loaded}" != "1"; then
+		setenv ab_raw_env_loaded 1
+		setenv ab_raw_env_imported
+		if test "${devtype}" = "nvme"; then
+			if nvme read ${load_addr} ${ab_env_offset_blocks} ${ab_env_size_blocks}; then
+				if env import -c ${load_addr} ${ab_env_size_bytes}; then
+					setenv ab_raw_env_imported 1
+				fi
+			fi
+		elif test "${devtype}" = "mmc"; then
+			if mmc dev ${devnum}; then
+				if mmc read ${load_addr} ${ab_env_offset_blocks} ${ab_env_size_blocks}; then
+					if env import -c ${load_addr} ${ab_env_size_bytes}; then
+						setenv ab_raw_env_imported 1
+					fi
+				fi
+			fi
+		fi
+	fi
+	if test "${ab_raw_env_imported}" = "1" && test "${boot_slot}" = "b"; then
+		setenv ab_target_bootpart ${distro_bootpart_b}
+	elif test "${ab_raw_env_imported}" = "1" && test "${boot_slot}" = "a"; then
+		setenv ab_target_bootpart ${distro_bootpart_a}
+	fi
+	if test -n "${ab_target_bootpart}" && test "${ab_target_bootpart}" != "${distro_bootpart}"; then
+		echo "Switching to AB boot slot ${boot_slot}: ${devtype} ${devnum}:${ab_target_bootpart}"
+		setenv distro_bootpart ${ab_target_bootpart}
+		if load ${devtype} ${devnum}:${distro_bootpart} ${scriptaddr} ${prefix}boot.scr; then
+			source ${scriptaddr}
+		fi
+	fi
+fi
+
 # default values
 setenv rootdev "/dev/mmcblk0p1"
 setenv verbosity "1"
